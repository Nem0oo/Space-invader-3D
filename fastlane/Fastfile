default_platform(:ios)

platform :ios do
  desc "Uploade un IPA déjà signé (compilé par Theos, signé par le workflow CI) vers TestFlight/App Store Connect. Upload seulement — pas de soumission automatique pour App Review."
  lane :publish_appstore do |options|
    ipa_path = options[:ipa_path]
    UI.user_error!("ipa_path manquant") if ipa_path.nil? || !File.exist?(ipa_path)

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true
    )

    pilot(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false
    )
  end
end
